<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiMessenger.Views.TopBar">

    <Grid 
          HeightRequest="56"
          BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
          ColumnDefinitions="Auto,*,Auto">

        <!-- Назад -->
        <Border
            Grid.Row="0"
            Grid.Column="1"
            Margin="8"
            HorizontalOptions="Start"
            StrokeShape="RoundRectangle 80,80,80,80"
            StrokeThickness="2"
            Stroke="#b1bad8">
            
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding UserProfileClickedCommand}" />
            </Border.GestureRecognizers>
            <Image
                Aspect="AspectFit"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Source="{Binding AvatarURL}">
                <Image.Triggers>
                    <DataTrigger TargetType="Image" Binding="{Binding AvatarURL}" Value="">
                        <Setter Property="Source" Value="photo.png"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Image" Binding="{Binding AvatarURL}" Value="{x:Null}">
                        <Setter Property="Source" Value="photo.png"/>
                    </DataTrigger>
                </Image.Triggers>
                <!--<Image.Source>
                    <AppThemeBinding
                        Light="user_light.png"
                        Dark="user_dark.png"/>
                </Image.Source>-->
            </Image>
        </Border>

        <!-- Заголовок -->
        <Label
            Grid.Column="1"
            Text="{Binding Title}"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            FontSize="18"
            FontAttributes="Bold" />


        <Border
            Grid.Row="0"
            Grid.Column="2"
            Margin="10"
            HorizontalOptions="Center"
            StrokeShape="RoundRectangle 80,80,80,80"
            StrokeThickness="0">

            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding SearchClickedCommand}" />
            </Border.GestureRecognizers>
            <Image
                Aspect="AspectFit"
                HorizontalOptions="Center"
                VerticalOptions="Center" >

                <Image.Source>
                    <AppThemeBinding
                        Light="search_light.png"
                        Dark="search_dark.png"/>
                </Image.Source>
            </Image>
        </Border>
    </Grid>



</ContentView>
