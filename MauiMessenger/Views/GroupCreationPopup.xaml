<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="MauiMessenger.Views.GroupCreationPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    CanBeDismissedByTappingOutsideOfPopup="True"
    HeightRequest="500"
    WidthRequest="300">

    <Grid RowDefinitions="Auto, *, Auto" RowSpacing="10">
        <VerticalStackLayout Grid.Row="0" Spacing="5">
            <Label
                FontSize="22"
                HorizontalTextAlignment="Center"
                Text="Название группы" />
            <Entry Placeholder="Введите название" Text="{Binding GroupName}" />
        </VerticalStackLayout>

        <Frame Grid.Row="1">
            <VerticalStackLayout Spacing="5">
                <Label
                    FontSize="20"
                    HorizontalTextAlignment="Center"
                    Text="Добавить участников" />
                <SearchBar
                    Placeholder="Поиск пользователей"
                    Text="{Binding SearchQuery, Mode=TwoWay}"
                    VerticalOptions="Center" />
                <CollectionView
                    ItemsSource="{Binding SearchResults}"
                    SelectedItems="{Binding SelectedGroupMembers, Mode=TwoWay}"
                    SelectionMode="Multiple">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                HeightRequest="80"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="Start">
                                <Grid BackgroundColor="Transparent" ColumnDefinitions="Auto, Auto, *">
                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="10"
                                        HorizontalOptions="Center"
                                        StrokeShape="RoundRectangle 80,80,80,80"
                                        StrokeThickness="0">
                                        <Image
                                            Aspect="AspectFit"
                                            HorizontalOptions="Center"
                                            SemanticProperties.Description="Cute dot net bot waving hi to you!"
                                            Source="image.png"
                                            VerticalOptions="Center" />
                                    </Border>
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Margin="10,0,0,0"
                                        FontSize="30"
                                        HorizontalOptions="FillAndExpand"
                                        Text="{Binding Username}"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Frame>
        <HorizontalStackLayout Grid.Row="2">
            <Button
                Command="{Binding CreateGroupChatCommand}"
                IsEnabled="True"
                Text="Создать" />
        </HorizontalStackLayout>
    </Grid>
</toolkit:Popup>
